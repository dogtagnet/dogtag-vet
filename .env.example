# dogtag-vet environment configuration.
#
# Copy this file to `.env` and fill in the values marked REQUIRED before running
# `docker compose up -d` or `pnpm dev`. Everything else has a working default (see
# `src/lib/env.ts`) and only needs to change for a non-default deployment.
#
# Receiving addresses for crypto payments, the entity/clone chain identity, and RPC
# overrides are NOT set here - they are configured from the running app's Settings
# page and setup wizard, and persisted in Mongo, so they can be changed without a
# redeploy.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

NODE_ENV=production

# REQUIRED. Mongo connection string. The docker-compose stack sets this for you to
# point at its own `mongo` service; only change it if you are pointing at a managed
# Mongo instance instead (see docs/DEPLOY.md).
MONGODB_URI=mongodb://mongo:27017/dogtag-vet

# REQUIRED. The public origin this deployment is served from, no trailing slash.
# Used to build every QR code and email link this app sends (mint, verify, booking
# confirmation, payment receipt) - get this wrong and every link this app generates
# points at the wrong place.
PUBLIC_BASE_URL=https://vet.example.com

# Number of reverse-proxy hops in front of this app that faithfully APPEND (never replace) the
# peer address they saw to X-Forwarded-For - see "Trusted proxy hops" in docs/DEPLOY.md. Left
# commented out (built-in default: 0) rather than shipped pre-set here, since this file is loaded
# verbatim by docker-compose.yml's env_file - uncommenting a value that assumes a reverse proxy is
# already in front of this app would be actively unsafe for anyone who runs `docker compose up`
# and reaches this app directly before adding one. With TRUSTED_PROXY_HOPS unset (0),
# X-Forwarded-For is NOT trusted at all and every public-route rate limit and the abuse log key
# EVERY caller under one shared "unknown" bucket - safe (a client cannot forge its way around it),
# but coarse: one abusive caller can 429 every other visitor too. Once this deployment is actually
# behind the reverse proxy this app's own docs recommend, uncomment and set this to 1 (a single
# nginx or Cloudflare hop directly in front of this app).
# TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------

# REQUIRED. Random secret for signing session JWTs. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Set to "1" only behind AUTH_TRUST_HOST-aware reverse proxies (Cloudflare Tunnel,
# most managed platforms) that terminate TLS and forward the original host header.
AUTH_TRUST_HOST=

# Google OAuth sign-in. Leave both blank to disable the Google provider entirely
# (email magic link and/or DEV_LOGIN can still be used).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# DEV/TEST ONLY. When set to exactly "1", registers a credentials sign-in provider
# (email only, no password) so Playwright and local development do not need a real
# OAuth or SMTP setup. The first account created this way becomes role "owner";
# every later one becomes "staff". NEVER set this in a real deployment - it is an
# unauthenticated login for anyone who knows (or guesses) a staff email address.
DEV_LOGIN=

# ---------------------------------------------------------------------------
# Email (magic-link sign-in, booking/payment/receipt notifications)
# ---------------------------------------------------------------------------

# Nodemailer transport URL, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
# The "From" address on every email this app sends.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# ROAX (DogTag identity chain, chainId 135 - and, as of WP4.18, this app's ONLY payment chain too)
# ---------------------------------------------------------------------------
# These, and the five protocol contract addresses below, are RUNTIME values: read fresh from this
# process's own env on every request and injected into each page for the browser
# (PublicConfigInitScript -> src/lib/env.public.ts), not build-time ones. Setting them here (or in
# Compose's env_file / Helm's ConfigMap/Secret) is enough on its own - no NEXT_PUBLIC_ copy is
# needed any more, and the exact same built image works for every environment (WP4.17 D2). A
# NEXT_PUBLIC_-prefixed twin is still accepted as a build-time fallback (see env.public.ts) for a
# context with no server-injected script at all, e.g. a unit test importing that module directly -
# a real deployment should never need to set one.
#
# WP4.18: ROAX is the only chain this app ever pays on (plans/wp4.18-roax-payments.md section 7) -
# the same ROAX_RPC_URL/ROAX_CHAIN_ID below serve both the identity reads and the payment watcher's
# reads. MIGRATION NOTE: an older deployment upgrading from before WP4.18 must have NO open
# (pending) crypto rails on any chain other than roax before upgrading - the four now-removed
# chains (Ethereum, Base, Sepolia, Base Sepolia) cannot be represented any more (their Mongo enum
# values are gone), so a pending rail on one of them cannot be read back after the upgrade. Settle
# or cancel every such invoice first.

ROAX_RPC_URL=https://roax-testnet-rpc.dogtag.example/rpc
ROAX_CHAIN_ID=135
ROAX_EXPLORER_URL=https://roax-testnet.blockscout.example

# REQUIRED (via the setup wizard, not here, but the contract addresses themselves
# come from this file). Protocol contract addresses on ROAX - the setup wizard
# reads these to discover this clinic's clone and check whitelist/registry status.
# Not secret: every one of these is public on chain, so serving them to the browser
# (see the runtime-value note above) is safe.
VET_ISSUER_FACTORY_ADDRESS=
ENTITY_REGISTRY_ADDRESS=
DOGTAG_SBT_ADDRESS=
VERIFICATION_REGISTRY_ADDRESS=

# WP4.15 multi-owner (PLANNED - not deployed on any real chain yet; docs/DEPLOY-wp4.15.md in the
# dogtag-protocol branch `feature/wp4.15-multi-owner` is Kenneth's own deployment runbook). Not a
# secret either (public on chain, like the four addresses above) and part of the same
# runtime-injected config, though no client code reads it directly yet - every browser write still
# targets the clinic's own clone (already known via `/api/settings`), never this address.
DELEGATION_REGISTRY_ADDRESS=

# DEV/TEST ONLY. When set to a wallet address, registers an extra wagmi `mock`
# connector (wagmi/connectors' own test connector) alongside the real MetaMask one,
# and auto-connects it on every page load - letting Playwright drive
# TagIssueWizard/TagsTable/VerifySessionPanel/SetupWizard (every one of which waits
# for a connected wallet) with no browser extension. NEVER set this in a real
# deployment - it silently "connects" a wallet the operator never chose.
NEXT_PUBLIC_E2E_MOCK_WALLET_ADDRESS=

# ---------------------------------------------------------------------------
# Payment confirmation depth (src/lib/payments/watcher.ts)
# ---------------------------------------------------------------------------
# Blocks mined after the block containing a payment's matching transfer before the watcher treats
# it as final (protects against a chain reorganisation). 2 is right for a devnet with sub-second
# blocks; raise it for a slower or less trusted chain.

CONFIRMATIONS_ROAX=2

# ---------------------------------------------------------------------------
# RUSD - the dev-only ERC-20 stablecoin on ROAX (docs/DEV-TOKENS.md in dogtag-protocol)
# ---------------------------------------------------------------------------
# RUSD has no canonical address this repo could ever bake in - it is deployed fresh per
# environment (see the workstation runbook's forge DeployRUSD.s.sol step) and its address recorded
# here afterward. The built-in default is an inert placeholder (0x999...) - the RUSD rail stays
# effectively disabled (the Settings/payment-creation UI shows a banner) until you set this to the
# real deployed address.

TOKEN_RUSD_ROAX_ADDRESS=

# ---------------------------------------------------------------------------
# Invoicing
# ---------------------------------------------------------------------------

# Prefix for sequential invoice numbers, e.g. INV-000042.
INVOICE_NUMBER_PREFIX=INV

# Pricing is manual-rate only (plans/wp4.18-roax-payments.md section 7: "rates are manual only") -
# staff enter a fiat-per-token rate on every crypto rail when creating an invoice (Settings has no
# price-feed configuration; RUSD's rate defaults to 1.00 in the invoice-creation form when the
# clinic's fiat currency is USD, but is always explicit and staff-editable, never fetched live).

# ---------------------------------------------------------------------------
# Worker process tuning (src/worker/index.ts)
# ---------------------------------------------------------------------------

# Payment watcher poll interval, in milliseconds.
PAYMENT_WATCHER_POLL_MS=30000
# Max blocks per scan iteration on ROAX. Smaller than the chain-activity follower's own
# ACTIVITY_CHUNK_BLOCKS below by design: the native PLASMA scan fetches one full block per
# iteration (heavier than a log-only query), not just a getLogs range.
PAYMENT_ACTIVITY_CHUNK_BLOCKS_ROAX=200

# Chain-activity follower: the block to start following this clinic's clone from.
# Leave at 0 (genesis) for ROAX, a low-volume identity chain where a full scan is
# cheap. Set to the clone's actual deploy block if you ever point this at a taller
# chain.
ACTIVITY_START_BLOCK=0
ACTIVITY_POLL_MS=15000
ACTIVITY_CHUNK_BLOCKS=2000

# Boot recovery (src/worker/index.ts): how long a MintSession may sit "issuing" before the worker
# treats it as stale and acts on it (reconciling it to "bound" if it actually anchored on chain
# while this process was down, or marking it "interrupted" otherwise). A seconds-old in-flight
# issuance from a still-alive process is always left alone regardless of this value.
MINT_SESSION_STALE_MS=300000

# Boot recovery (src/lib/delegation/bootRecovery.ts): the exact same staleness rule as
# MINT_SESSION_STALE_MS above, for a DelegationSession sitting "submitting" instead of a
# MintSession sitting "issuing" - measured from submittingAt, never createdAt.
DELEGATION_SESSION_STALE_MS=300000

# ---------------------------------------------------------------------------
# Worker health server (WP4.17 B10 - src/worker/health.ts)
# ---------------------------------------------------------------------------
# The worker process serves GET /healthz (readiness: Mongo connectivity plus both loops' recent
# progress, with the activity cursor and per-chain payment watcher state) and GET /livez
# (liveness: both loops' recent progress only, never Mongo - a dependency outage should mark this
# worker not-ready, not get its container restarted) on this port. Point a Kubernetes readiness
# probe at /healthz and a liveness probe at /livez (the Helm chart's worker template already does
# both - see helm/dogtag-vet/values.yaml's `worker.healthPort`). Compose publishes this same port;
# `docker compose ps` and `curl localhost:8091/healthz` both work out of the box with the default.
WORKER_HEALTH_PORT=8091

# How many minutes either loop may go without observed progress before /healthz and /livez report
# "degraded" (503). "Progress" means different things for the two loops - the chain-activity
# follower measures the observed ROAX block tip advancing; the payment watcher measures a
# completed poll attempt, since it is often legitimately idle - see workerHealth.ts for the full
# reasoning. Mirrors dogtag-admin's INDEXER_STALL_MINUTES.
WORKER_STALL_MINUTES=10
